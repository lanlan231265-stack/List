    let activeQuestions = [];
    let currentIndex = 0;
    let score = 0;
    let wrongQuestions = [];

    const startScreen = document.getElementById("start-screen");
    const quizScreen = document.getElementById("quiz-screen");
    const resultScreen = document.getElementById("result-screen");

    function startQuiz(onlyWrong) {
      if (onlyWrong && wrongQuestions.length > 0) {
        activeQuestions = [...wrongQuestions];
      } else {
        activeQuestions = [...fullQuestions];
      }
      wrongQuestions = [];
      currentIndex = 0;
      score = 0;

      startScreen.classList.add("hidden");
      resultScreen.classList.add("hidden");
      quizScreen.classList.remove("hidden");

      renderQuestion();
    }

    function renderQuestion() {
      const q = activeQuestions[currentIndex];
      const total = activeQuestions.length;

      document.getElementById("progress-text").textContent = `第 ${currentIndex + 1} / ${total} 題`;
      document.getElementById("score-live").textContent = `答對題數：${score}`;
      document.getElementById("progress-fill").style.width = `${((currentIndex) / total) * 100}%`;

      document.getElementById("q-category").textContent = q.category;
      document.getElementById("q-text").textContent = q.question;

      const optionsContainer = document.getElementById("options-container");
      optionsContainer.innerHTML = "";

      const prefixes = ["A", "B", "C", "D"];
      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `<span class="option-prefix">${prefixes[idx]}.</span><span>${opt}</span>`;
        btn.onclick = () => handleAnswer(idx, btn);
        optionsContainer.appendChild(btn);
      });

      const expBox = document.getElementById("explanation-box");
      expBox.classList.remove("show");
      document.getElementById("next-wrap").classList.remove("show");
    }

    function handleAnswer(selectedIndex, selectedBtn) {
      const q = activeQuestions[currentIndex];
      const optionBtns = document.querySelectorAll(".option-btn");

      optionBtns.forEach(btn => btn.disabled = true);

      const expTitle = document.getElementById("exp-title");
      const expText = document.getElementById("exp-text");
      const expBox = document.getElementById("explanation-box");

      if (selectedIndex === q.answer) {
        selectedBtn.classList.add("correct");
        score++;
        expTitle.textContent = "✅ 答對了！觀念非常正確";
        expTitle.style.color = "#2a9d8f";
      } else {
        selectedBtn.classList.add("wrong");
        optionBtns[q.answer].classList.add("correct");
        wrongQuestions.push(q);
        expTitle.textContent = "❌ 再留意一下喔！正確答案已標示";
        expTitle.style.color = "#e63946";
      }

      document.getElementById("score-live").textContent = `答對題數：${score}`;
      expText.textContent = q.explanation;
      expBox.classList.add("show");

      const nextBtn = document.getElementById("next-btn");
      nextBtn.textContent = currentIndex === activeQuestions.length - 1 ? "查看測驗結果 🏁" : "下一題 ➔";
      document.getElementById("next-wrap").classList.add("show");
    }

    function nextQuestion() {
      currentIndex++;
      if (currentIndex < activeQuestions.length) {
        renderQuestion();
      } else {
        showResults();
      }
    }

    function showResults() {
      quizScreen.classList.add("hidden");
      resultScreen.classList.remove("hidden");

      const total = activeQuestions.length;
      const finalPercentage = Math.round((score / total) * 100);
      document.getElementById("final-score").textContent = finalPercentage;

      const titleEl = document.getElementById("result-title");
      const descEl = document.getElementById("result-desc");

      if (finalPercentage === 100) {
        titleEl.textContent = "🏆 滿分通關！專業守護者";
        descEl.textContent = `全數答對（${score}/${total} 題）！您對不適切照護的界線、正向引導與風險預防都有非常扎實的認知。`;
      } else if (finalPercentage >= 80) {
        titleEl.textContent = "👏 表現優秀！觀念很穩固";
        descEl.textContent = `共答對 ${score}/${total} 題。建議再檢視一下錯題解析，讓日常托育防護做到零死角！`;
      } else {
        titleEl.textContent = "💪 繼續加油！安全意識再升級";
        descEl.textContent = `共答對 ${score}/${total} 題。托育現場許多高風險行為往往源自習慣或一時心急，建議點擊下方重練錯題加深印象。`;
      }

      const retryWrongBtn = document.getElementById("retry-wrong-btn");
      const reviewSection = document.getElementById("review-section");
      const reviewContainer = document.getElementById("review-container");

      if (wrongQuestions.length > 0) {
        retryWrongBtn.classList.remove("hidden");
        reviewSection.classList.remove("hidden");
        reviewContainer.innerHTML = "";
        wrongQuestions.forEach((wq, i) => {
          const item = document.createElement("div");
          item.className = "review-item";
          item.innerHTML = `
            <strong>題目：${wq.question}</strong>
            <div style="color:#2a9d8f; font-weight:600; margin-bottom:4px;">✔ 正確作法：${wq.options[wq.answer]}</div>
            <div style="color:#495057;">💡 解析：${wq.explanation}</div>
          `;
          reviewContainer.appendChild(item);
        });
      } else {
        retryWrongBtn.classList.add("hidden");
        reviewSection.classList.add("hidden");
      }
    }
  </script>
